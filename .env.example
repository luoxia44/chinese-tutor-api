# ─────────────────────────────────────────────────────────────
# AI 中文口语陪练 — environment config
# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.
# (Mirrors SwiftUI's Config/Secrets.xcconfig — CLAUDE.md §安全与合规)
# ─────────────────────────────────────────────────────────────

# Server port
PORT=5173

# ── Voice / Brain engine selection ──
# "mock"    = offline, no key needed. Browser STT/TTS + level-aware canned brain.
#             The whole loop (talk → in-character reply → memory) runs WITHOUT any key.
# "minimax" = real MiniMax. Requires MINIMAX_API_KEY below.
ENGINE=mock

# ── MiniMax (overseas / global site — do NOT use the China endpoint, per spec §3.3) ──
# Get both from https://platform.minimax.io  (API Keys page + account GroupID).
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# OpenAI-compatible chat endpoint (the dialogue "brain")
MINIMAX_CHAT_URL=https://api.minimax.io/v1/text/chatcompletion_v2
MINIMAX_CHAT_MODEL=MiniMax-Text-01
# Text-to-Audio endpoints (the voice). Realtime S2S can replace these behind the adapter.
MINIMAX_TTS_URL=https://api.minimax.io/v1/t2a_v2
MINIMAX_TTS_WS_URL=wss://api.minimax.io/ws/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-2.6-hd

# Stream audio over WebSocket for lower first-audio latency (default off; REST is the reliable path).
VOICE_STREAMING=false

# ── Avatar image generation (OpenAI 图像 API) — used by scripts/generate-avatars.js ──
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium

# Summarizer LLM (memory). Defaults to the same MiniMax chat endpoint.
# Spec suggests a cheap zh-strong model (Qwen/DeepSeek) — swap the URL/model/key here.
SUMMARIZER_URL=
SUMMARIZER_MODEL=
SUMMARIZER_API_KEY=

# 记忆持久化备份（Upstash Redis REST，免费档；不配则记忆只存本地磁盘）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
